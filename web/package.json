{
  "name": "vibemobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && node scripts/build-server.js",
    "build:web": "tsc -b && vite build",
    "build:server": "node scripts/build-server.js",
    "start": "node dist/server.cjs",
    "preview": "npm run build && npm run start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.9",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "uuid": "^11.1.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.7",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/uuid": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/multer": "^1.4.12",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
